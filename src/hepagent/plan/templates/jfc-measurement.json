{
  "schema_version": 1,
  "description": "The seven-node JFC pipeline for a measurement: strategy, exploration, selection, three staged inference nodes, documentation.",
  "name": "jfc-measurement",
  "analysis_type": "measurement",
  "metadata": {
    "blinding": "staged",
    "note": "Node ids are stable slugs. Directory and artifact names match the paths cited by data/methodology/ and data/conventions/."
  },
  "nodes": [
    {
      "id": "strategy",
      "label": "Strategy",
      "directory": "phase1_strategy",
      "artifact": "STRATEGY.md",
      "prompt_ref": "templates/phase1_claude.md",
      "reviewers": [
        "physics",
        "critical",
        "constructive"
      ],
      "arbiter": true,
      "gates": [
        {
          "name": "codesign",
          "when": "after",
          "enabled": false
        }
      ],
      "contract": {
        "node_types": [
          "commitment",
          "method",
          "dataset"
        ],
        "edge_types": [
          "commits_to",
          "requires"
        ]
      }
    },
    {
      "id": "exploration",
      "label": "Exploration",
      "directory": "phase2_exploration",
      "artifact": "EXPLORATION.md",
      "prompt_ref": "templates/phase2_claude.md",
      "reviewers": [
        "plot"
      ],
      "contract": {
        "node_types": [
          "dataset",
          "evidence",
          "figure"
        ],
        "edge_types": [
          "derives_from",
          "supports"
        ]
      }
    },
    {
      "id": "selection",
      "label": "Selection",
      "directory": "phase3_selection",
      "artifact": "SELECTION.md",
      "prompt_ref": "templates/phase3_claude.md",
